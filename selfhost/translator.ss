;;; translator.ss — JSON AST → Scheme S-expressions
;;; Usage: php parse.php input.php | scheme --script translator.ss > output.ss

(import (chezscheme))

;; ========== JSON Reader ==========

(define (read-json)
  (let ((s (get-string-all (current-input-port))))
    (json-parse s)))

(define (json-parse s)
  ;; Use a simple recursive descent parser
  (define i 0)
  (define (peek) (if (< i (string-length s)) (string-ref s i) #\nul))
  (define (adv) (set! i (+ i 1)))
  (define (skip-spaces)
    (let loop ()
      (when (and (< i (string-length s))
                 (let ((c (peek)))
                   (or (char=? c #\space) (char=? c #\newline)
                       (char=? c #\tab) (char=? c #\return))))
        (adv) (loop))))
  
  (define (parse)
    (skip-spaces)
    (let ((c (peek)))
      (cond ((char=? c #\{) (parse-obj))
            ((char=? c #\[) (parse-arr))
            ((char=? c #\") (parse-str))
            ((char=? c #\t) (adv) (adv) (adv) (adv) #t)
            ((char=? c #\f) (adv) (adv) (adv) (adv) (adv) #f)
            ((char=? c #\n) (adv) (adv) (adv) (adv) 'null)
            ((or (char-numeric? c) (char=? c #\-) (char=? c #\+))
             (parse-num))
            (#t (error 'json-parse "unexpected" c)))))
  
  (define (parse-obj)
    (adv) ;; {
    (skip-spaces)
    (if (char=? (peek) #\})
        (begin (adv) '())
        (let loop ((pairs '()))
          (let* ((k (parse-str)))
            (skip-spaces) (adv) ;; :
            (skip-spaces)
            (let ((v (parse)))
            (skip-spaces)
            (let ((new-pairs (cons (cons k v) pairs)))
              (if (char=? (peek) #\,)
                  (begin (adv) (skip-spaces) (loop new-pairs))
                  (begin (adv) (reverse new-pairs))))))))
  
  (define (parse-arr)
    (adv) ;; [
    (skip-spaces)
    (if (char=? (peek) #\])
        (begin (adv) '())
        (let loop ((els '()))
          (let ((v (parse)))
            (skip-spaces)
            (let ((new-els (append els (list v))))
              (if (char=? (peek) #\,)
                  (begin (adv) (skip-spaces) (loop new-els))
                  (begin (adv) new-els)))))))
  
  (define (parse-str)
    (adv) ;; "
    (let loop ((chars '()))
      (let ((c (peek)))
        (if (char=? c #\")
            (begin (adv) (list->string (reverse chars)))
            (begin (adv)
                   (if (char=? c #\\)
                       (let ((c2 (peek)))
                         (adv)
                         (loop (cons (case c2
                                      ((#\") #\") ((#\\) #\\)
                                      ((#\/) #\/) ((#\n) #\newline)
                                      ((#\r) #\return) ((#\t) #\tab)
                                      ((#\b) #\backspace) ((#\f) #\page)
                                      (#t c2)) chars)))
                       (loop (cons c chars))))))))
  
  (define (parse-num)
    (let ((start i))
      (when (or (char=? (peek) #\-) (char=? (peek) #\+)) (adv))
      (let loop ()
        (when (char-numeric? (peek)) (adv) (loop)))
      (when (char=? (peek) #\.) (adv)
        (let loop () (when (char-numeric? (peek)) (adv) (loop))))
      (when (char=? (peek) #\e) (adv)
        (when (or (char=? (peek) #\-) (char=? (peek) #\+)) (adv))
        (let loop () (when (char-numeric? (peek)) (adv) (loop))))
      (string->number (substring s start i))))
  
  (skip-spaces)
  (parse))


;; ========== AST Helpers ==========

(define (ast-kind node)
  (if (pair? node) (cdr (assq 'kind node))
      (if (vector? node) (vector-ref node 0)
          (error 'ast-kind "invalid node" node))))

(define (ast-get node key . default)
  (let ((found (assq key (if (pair? node) node (vector->list node)))))
    (if found (cdr found)
        (if (null? default) '() (car default)))))

(define (ast-children node)
  (let ((c (ast-get node 'children '())))
    (if (vector? c) (vector->list c) c)))

(define (ast-child node i)
  (let ((c (ast-children node)))
    (and (< i (length c)) (list-ref c i))))

;; ========== Name Mangling ==========

(define (mangle-php-name name)
  (let* ((s (if (and (> (string-length name) 0) (eqv? (string-ref name 0) #\$))
                (substring name 1 (string-length name))
                name)))
    (string-append "php-" (string-downcase s))))

(define (mangle-func-name name)
  (string-append "php-fn-" (string-downcase name)))

;; ========== Expression Translation ==========

(define (translate-expr node)
  (let ((kind (ast-kind node)))
    (cond ((string=? kind "LITERAL")
           (let ((val (ast-child node 0)) (type (ast-child node 1)))
             (cond ((string=? type "int") (number->string val))
                   ((string=? type "float") (number->string val))
                   ((string=? type "string")
                    (string-append "\"" val "\""))
                   ((string=? type "bool") (if val "#t" "#f"))
                   ((string=? type "null") "'null")
                   (#t (error 'translate "unknown lit type" type)))))
          ((string=? kind "VAR")
           (mangle-php-name (ast-child node 0)))
          ((string=? kind "NAME")
           (let ((n (ast-child node 0)))
             (if (and (> (string-length n) 0) (eqv? (string-ref n 0) #\\))
                 (substring n 1 (string-length n)) n)))
          ((string=? kind "BINARY_OP")
           (let ((op (ast-child node 0)) (l (translate-expr (ast-child node 1))) (r (translate-expr (ast-child node 2))))
             (cond ((string=? op "+") (string-append "(php-add " l " " r ")"))
                   ((string=? op "-") (string-append "(php-sub " l " " r ")"))
                   ((string=? op "*") (string-append "(php-mul " l " " r ")"))
                   ((string=? op "/") (string-append "(php-div " l " " r ")"))
                   ((string=? op "%") (string-append "(php-mod " l " " r ")"))
                   ((string=? op ".") (string-append "(php-concat " l " " r ")"))
                   ((string=? op "==") (string-append "(php-eq " l " " r ")"))
                   ((string=? op "!=") (string-append "(php-ne " l " " r ")"))
                   ((string=? op "===") (string-append "(php-id " l " " r ")"))
                   ((string=? op "!==") (string-append "(php-nid " l " " r ")"))
                   ((string=? op "<") (string-append "(php-lt " l " " r ")"))
                   ((string=? op ">") (string-append "(php-gt " l " " r ")"))
                   ((string=? op "<=") (string-append "(php-le " l " " r ")"))
                   ((string=? op ">=") (string-append "(php-ge " l " " r ")"))
                   ((string=? op "&&") (string-append "(and " l " " r ")"))
                   ((string=? op "||") (string-append "(or " l " " r ")"))
                   ((string=? op "??") (string-append "(php-coalesce " l " " r ")"))
                   (#t (string-append "(php-binop '" op " " l " " r ")")))))
          ((string=? kind "UNARY_OP")
           (let ((op (ast-child node 0)) (e (translate-expr (ast-child node 1))))
             (cond ((string=? op "!") (string-append "(not " e ")"))
                   ((string=? op "~") (string-append "(bitwise-not " e ")"))
                   ((string=? op "-") (string-append "(- 0 " e ")"))
                   ((string=? op "+") e)
                   (#t (string-append "(php-unop '" op " " e ")")))))
          ((string=? kind "PRE_OP")
           (let ((op (ast-child node 0)) (e (translate-expr (ast-child node 1))))
             (if (string=? op "++") (string-append "(php-pre-inc " e ")") (string-append "(php-pre-dec " e ")"))))
          ((string=? kind "POST_OP")
           (let ((op (ast-child node 0)) (e (translate-expr (ast-child node 1))))
             (if (string=? op "++") (string-append "(php-post-inc " e ")") (string-append "(php-post-dec " e ")"))))
          ((string=? kind "ASSIGN")
           (let ((target (ast-child node 0)) (value (translate-expr (ast-child node 1))))
             (string-append "(set! " (translate-lvalue target) " " value ")")))
          ((string=? kind "ASSIGN_OP")
           (let* ((op (ast-child node 0)) (target (ast-child node 1)) (value (translate-expr (ast-child node 2))) (lval (translate-lvalue target)))
             (string-append "(php-assign-op '" op " " lval " " value ")")))
          ((string=? kind "CALL")
           (let* ((func (ast-child node 0)) (args (list-tail (ast-children node) 1))
                   (fname (if (string=? (ast-kind func) "NAME")
                              (let ((n (ast-child func 0)))
                                (if (string=? n "array") "php-array"
                                    (if (string=? n "print") "php-print"
                                        (if (string=? n "echo") "php-echo"
                                            (mangle-func-name n)))))
                              (translate-expr func)))
                   (args-str (string-join (map translate-expr args) " ")))
             (if (string=? args-str "") (string-append "(" fname ")")
                 (string-append "(" fname " " args-str ")"))))
          ((string=? kind "METHOD_CALL")
           (let* ((obj (translate-expr (ast-child node 0))) (method (ast-child node 1))
                   (args (list-tail (ast-children node) 2))
                   (args-str (string-join (map translate-expr args) " ")))
             (string-append "(php-method-call " obj " '" method " " args-str ")")))
          ((string=? kind "STATIC_CALL")
           (let* ((class (translate-expr (ast-child node 0))) (method (ast-child node 1))
                   (args (list-tail (ast-children node) 2))
                   (args-str (string-join (map translate-expr args) " ")))
             (string-append "(php-static-call " class " '" method " " args-str ")")))
          ((string=? kind "NEW")
           (let* ((class (ast-child node 0))
                   (cname (if (pair? class) (ast-child class 0) "stdClass"))
                   (args (list-tail (ast-children node) 1))
                   (args-str (string-join (map translate-expr args) " ")))
             (string-append "(php-new \"" cname "\" " args-str ")")))
          ((string=? kind "DIM")
           (let ((arr (translate-expr (ast-child node 0))) (key (and (ast-child node 1) (translate-expr (ast-child node 1)))))
             (if key (string-append "(php-array-ref " arr " " key ")") (string-append "(php-array-push " arr ")"))))
          ((string=? kind "PROP")
           (let ((obj (translate-expr (ast-child node 0))) (prop (ast-child node 1)))
             (string-append "(php-prop-get " obj " '" prop ")")))
          ((string=? kind "STATIC_PROP")
           (let ((class (translate-expr (ast-child node 0))) (prop (ast-child node 1)))
             (string-append "(php-static-prop-get " class " '" prop ")")))
          ((string=? kind "CONDITIONAL")
           (let ((cnd (translate-expr (ast-child node 0))) (then (translate-expr (ast-child node 1))) (els (translate-expr (ast-child node 2))))
             (string-append "(if " cnd " " then " " els ")")))
          ((string=? kind "ARRAY")
           (let ((items (map translate-array-elem (ast-children node))))
             (string-append "(php-array " (string-join items " ") ")")))
          ((string=? kind "SILENCE")
           (translate-expr (ast-child node 0)))
          (#t (error 'translate-expr "unknown expression" kind)))))

(define (translate-lvalue node)
  (let ((kind (ast-kind node)))
    (cond ((string=? kind "VAR") (mangle-php-name (ast-child node 0)))
          ((string=? kind "DIM")
           (let ((arr (translate-lvalue (ast-child node 0)))
                 (key (and (ast-child node 1) (translate-expr (ast-child node 1)))))
             (if key (string-append "(php-array-ref " arr " " key ")") arr)))
          ((string=? kind "PROP")
           (string-append "(php-prop-get " (translate-expr (ast-child node 0)) " '" (ast-child node 1) ")"))
          (#t (translate-expr node)))))

(define (translate-array-elem node)
  (let ((children (ast-children node)))
    (if (= (length children) 1)
        (string-append "(cons #f " (translate-expr (car children)) ")")
        (string-append "(cons " (translate-expr (car children)) " " (translate-expr (cadr children)) ")"))))

;; ========== Statement Translation ==========

(define (translate-stmt node indent)
  (let ((kind (ast-kind node)))
    (cond
      ((string=? kind "STMT_LIST")
       (translate-stmt-list (ast-children node) indent))
      ((string=? kind "ECHO")
       (string-append indent "(php-echo " (translate-expr (car (ast-children node))) ")\n"))
      ((string=? kind "RETURN")
       (let ((val (ast-child node 0)))
         (if val (string-append indent "(values " (translate-expr val) ")\n")
             (string-append indent "(values 'null)\n"))))
      ((string=? kind "IF")
       (let* ((cnd (translate-expr (ast-child node 0))) (then-node (ast-child node 1))
               (else-node (ast-child node 2))
               (then-str (translate-stmt then-node (string-append indent "  ")))
               (else-str (if else-node (string-append indent "  " (translate-stmt else-node (string-append indent "  "))) "")))
         (string-append indent "(if " cnd "\n" then-str (if (string? else-str) (string-append indent else-str) "") ")")))
      ((string=? kind "WHILE")
       (let ((cnd (translate-expr (ast-child node 0))) (body (ast-child node 1)))
         (string-append indent "(let loop ()\n" indent "  (if " cnd "\n"
                        (translate-stmt body (string-append indent "      "))
                        indent "      (loop)))\n")))
      ((string=? kind "FOR")
       (let ((init (and (ast-child node 0) (translate-expr (ast-child node 0))))
             (cnd (and (ast-child node 1) (translate-expr (ast-child node 1))))
             (incr (and (ast-child node 2) (translate-expr (ast-child node 2))))
             (body (ast-child node 3)))
         (string-append indent "(begin\n"
                        (if init (string-append indent "  " init "\n") "")
                        indent "  (let loop ()\n"
                        indent "    (if " (or cnd "#t") "\n"
                        (translate-stmt body (string-append indent "        "))
                        (if incr (string-append indent "        " incr "\n") "")
                        indent "        (loop)))\n")))
      ((string=? kind "FOREACH")
       (let* ((children (ast-children node)) (expr (translate-expr (list-ref children 0)))
               (val-node (list-ref children 1))
               (key-node (and (> (length children) 2)
                              (not (string=? (ast-kind (list-ref children 2)) "STMT_LIST"))
                              (list-ref children 2)))
               (body (list-ref children (- (length children) 1)))
               (val-str (translate-lvalue val-node)))
         (if key-node
             (let ((k (translate-lvalue key-node)))
               (string-append indent "(php-foreach " expr " (lambda (" k " " val-str ")\n"
                              (translate-stmt body (string-append indent "  ")) indent "))\n"))
             (string-append indent "(php-foreach " expr " (lambda (" val-str ")\n"
                            (translate-stmt body (string-append indent "  ")) indent "))\n"))))
      ((string=? kind "BREAK") (string-append indent "(break)\n"))
      ((string=? kind "CONTINUE") (string-append indent "(continue)\n"))
      ((string=? kind "THROW") (string-append indent "(raise " (translate-expr (ast-child node 0)) ")\n"))
      ((string=? kind "SWITCH")
       (let* ((expr (translate-expr (ast-child node 0))) (cases (ast-child node 1)))
         (string-append indent "(case " expr "\n"
                        (string-join (map (lambda (c)
                           (let* ((cc (ast-children c)) (val (and (pair? cc) (car cc)))
                                   (body (and (pair? cc) (last cc)))
                                   (val-str (if val (translate-expr val) "else")))
                             (string-append indent "  ((" val-str ")\n"
                                            (translate-stmt body (string-append indent "    "))
                                            indent "  )\n"))) (ast-children cases))) ""))
         (string-append indent ")\n")))
      ((string=? kind "FUNC_DECL")
       (let* ((name (ast-child node 0)) (params (ast-child node 1)) (body (ast-child node 2))
               (param-str (string-join (map (lambda (p) (mangle-php-name (car (ast-children p)))) (ast-children params)) " ")))
         (string-append indent "(define " (mangle-func-name name) " (lambda (" param-str ")\n"
                        (translate-stmt body (string-append indent "  ")) indent "))\n")))
      ((string=? kind "CLASS")
       (let* ((name (ast-child node 0)) (extends (ast-child node 1)) (members (ast-child node 3)))
         (string-append indent ";; class " name "\n"
                        (string-join (map (lambda (m) (translate-stmt m indent))
                                         (ast-children (or members '(#(("kind" . "STMT_LIST") ("children" . #())))))) ""))))
      ((string=? kind "METHOD")
       (let* ((name (ast-child node 0)) (params (ast-child node 1)) (body (ast-child node 2))
               (param-str (string-join (map (lambda (p) (mangle-php-name (car (ast-children p)))) (ast-children params)) " ")))
         (string-append indent "(define (php-method-" (string-downcase name) " self " param-str ")\n"
                        (translate-stmt body (string-append indent "  ")) indent ")\n")))
      ((string=? kind "PROP_DECL")
       (string-join (map (lambda (p)
          (let ((var (ast-child p 0)) (init (ast-child p 1)))
            (string-append indent "(define " (mangle-php-name (car (ast-children var))) " "
                           (if init (translate-expr init) "'null") ")\n"))) (ast-children node)) ""))
      ((string=? kind "GLOBAL")
       (string-join (map (lambda (v) (string-append indent "(define " (translate-lvalue v) " 'null)\n")) (ast-children node)) ""))
      ((string=? kind "NAMESPACE") "")
      ((string=? kind "USE") "")
      (#t (let ((e (translate-expr node)))
            (if (string? e) (string-append indent e "\n")
                (string-append indent "(begin " e ")\n"))))))

(define (translate-stmt-list nodes indent)
  (string-join (map (lambda (n) (translate-stmt n indent)) nodes) ""))

;; ========== Main ==========

(define (translate-program ast)
  (let* ((prog (ast-children ast))
         (stmts (if (null? prog) '()
                    (if (pair? (car prog)) (car prog) prog))))
    (string-join (map (lambda (s) (translate-stmt s "")) stmts) "")))

(let ((ast (read-json)))
  (display ";; Generated by ReScheme PHP frontend\n")
  (display "(import (chezscheme))\n")
  (display "(load \"prelude.scm\")\n\n")
  (display (translate-program ast)))
